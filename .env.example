# Copy this file to ".env" and fill it in. ".env" is git-ignored: never commit it.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# That is all you need to run it locally. Everything below is optional.

# Use a different Gemini model:
# GEMINI_MODEL=gemini-3.5-flash-lite

# Hide the Telegram link by leaving the name empty:
# TELEGRAM_BOT_USERNAME=UncleFeryBot

# Extra addresses the site may be reached at. Not needed locally: localhost and
# 127.0.0.1 always work. To open the dev server from another device (your phone, say),
# put that machine's address here and start the server with:
#   python manage.py runserver 0.0.0.0:8000
# On a server, put your domain(s) here, comma-separated. Required when debug is off.
# DJANGO_ALLOWED_HOSTS=192.168.1.20

# Putting the site on a server? Debug is on by default, which is right for local use.
# Turning it off makes the secret key and the hosts line above mandatory.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# and keep the single quotes around it.
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY='paste-the-generated-key-here'

# Only when the site is served over HTTPS, comma-separated:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
